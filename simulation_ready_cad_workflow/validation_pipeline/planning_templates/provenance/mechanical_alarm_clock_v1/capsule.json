  "declared_nominal_tests": [
    {
      "input_port_id": "winding_key_torque",
      "schedule": "Apply winding-direction torque, observe hand advance and hammer swing, settle, then apply controlled reverse torque and return."
    },
    {
      "input_port_id": "manual_setting_torque",
      "schedule": "Engage the finite setting clutch, torque only the rear crown, verify all three hands keep their ratios, reverse, and settle."
    },
    {
      "input_port_id": "alarm_winding_key_torque",
      "schedule": "Hold the time barrel, torque only the independent alarm barrel, verify the hammer swings while all three hands remain still, reverse, and settle."
    },
    {
      "input_port_id": "alarm_time_by_hour_hand_torque",
      "schedule": "Turn only the hour hand in alarm-setting mode, verify the finite clutch moves and latches the separate alarm-target cam, restore the current display, then run the time barrel until the hour hand reaches the selected target and releases the independent alarm barrel."
    }
