  "expected_behavior": {
    "description": "The time barrel runs the three-hand display at the declared ratios. A mechanically separate alarm barrel drives only the alarm cam and hammer. Pull-to-set mode engages the rear crown for independent time adjustment. Alarm-setting mode lets the user turn the hour hand through a second finite clutch to latch a separately retained alarm-target cam; the independent alarm releases only when the running hour hand reaches that selected cam position.",
    "dof": [
      {
        "motion": "fifteen_supported_revolute_shafts_with_eight_gear_meshes_one_seconds_transfer_two_cam_followers_one_time_setting_clutch_and_one_hour_hand_alarm_target_clutch"
      }
    ],
    "failure_conditions": [
      "shaft leaves bearing bridge",
      "gear phase error exceeds tolerance",
      "hand train stalls or reverses unexpectedly",
      "hour/minute ratio leaves 1:12 tolerance",
      "second/minute ratio leaves 60:1 tolerance",
      "manual setting fails to back-drive all three hands",
      "balance fails to oscillate",
      "hammer fails to swing",
      "hour hand fails to latch the alarm target cam",
      "alarm rings before the hour hand reaches the selected target",
      "non-joint solids penetrate"
    ]
  },
