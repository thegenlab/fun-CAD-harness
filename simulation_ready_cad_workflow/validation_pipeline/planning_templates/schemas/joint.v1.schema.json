{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation_ready_cad_joint_template_v1",
  "title": "Simulation-ready CAD joint planning template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "template_id",
    "version",
    "title",
    "category",
    "goal",
    "family",
    "capability_variants",
    "input_wrench_kinds",
    "observable_quantities",
    "components",
    "required_instance_fields",
    "source_bindings",
    "constraints",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "simulation_ready_cad_joint_template_v1"
    },
    "kind": {
      "const": "joint"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "enum": [
        "primitive_joint",
        "compound_joint"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "family": {
      "enum": [
        "revolute",
        "prismatic",
        "compound"
      ]
    },
    "capability_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "plugin_id",
          "mechanism_kind",
          "runtime_status"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "plugin_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "mechanism_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_status": {
            "enum": [
              "ACTIVE",
              "IMPLEMENTATION_REQUIRED"
            ]
          },
          "capability_ids": {
            "$ref": "#/$defs/stringList"
          },
          "model_boundary_ids": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "input_wrench_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "force",
          "torque"
        ]
      }
    },
    "observable_quantities": {
      "$ref": "#/$defs/nonemptyStringList"
    },
    "components": {
      "$ref": "#/$defs/stringList"
    },
    "required_instance_fields": {
      "$ref": "#/$defs/nonemptyStringList"
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "constraints": {
      "$ref": "#/$defs/nonemptyStringList"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "nonemptyStringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "capsule_id",
        "source_status",
        "capsule_path",
        "capsule_sha256",
        "family_spec_path",
        "family_spec_sha256"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "capsule_id": {
          "type": "string"
        },
        "source_status": {
          "enum": [
            "PROJECT_CERTIFIED",
            "CAPABILITY_CERTIFIED",
            "DEMO_HISTORICAL_PASS",
            "UNRESOLVED_EXEMPLAR"
          ]
        },
        "capsule_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "capsule_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "family_spec_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "family_spec_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approved_on",
        "basis"
      ],
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "approved_by": {
          "type": "string"
        },
        "approved_on": {
          "type": "string",
          "format": "date"
        },
        "basis": {
          "type": "string"
        }
      }
    }
  }
}
