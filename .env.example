# scripts/setup_conda.sh writes .env with the values of your installation.
# Copy this file to .env to configure an existing installation by hand.
SIMREADY_CAD_PYTHON=/path/to/envs/funcad-cad/bin/python
SIMREADY_PYCHRONO_EXECUTABLE=/path/to/envs/funcad-chrono/bin/python
PYTHONNOUSERSITE=1
# Language of labels baked into rendered images (en or zh).
SIMREADY_RENDER_LANG=en
# Linux only: the CAD environment's lib directory.
LD_LIBRARY_PATH=/path/to/envs/funcad-cad/lib
